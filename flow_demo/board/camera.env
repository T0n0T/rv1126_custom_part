# 板载摄像头实时检测参数；也可通过同名环境变量覆盖。
# 留空使用原 YOLO26；轻量候选可填写 runs/rknn 下六头 INT8 模型的完整路径。
MODEL=${MODEL:-}
CAMERA_DEVICE=${CAMERA_DEVICE:-/dev/video25}
CAMERA_ID=${CAMERA_ID:-0}
IQ_DIR=${IQ_DIR:-/oem/usr/share/iqfiles}
CAPTURE_WIDTH=${CAPTURE_WIDTH:-640}
CAPTURE_HEIGHT=${CAPTURE_HEIGHT:-360}
CAPTURE_FPS=${CAPTURE_FPS:-30}
# 这块板 RGB24 采集口实测字节顺序为 BGR；检测输出仍为 RGB。
CAMERA_COLOR_ORDER=${CAMERA_COLOR_ORDER:-BGR}
# 相机补转 180°，修正上下/左右倒置；角度按顺时针。
CAMERA_ROTATION=${CAMERA_ROTATION:-180}
# 整屏（含文字/框/区域）逆时针 90°；面板原生尺寸不变。
SCREEN_ROTATION=${SCREEN_ROTATION:-270}
CONNECTOR_ID=${CONNECTOR_ID:-97}
PLANE_ID=${PLANE_ID:-75}
SCREEN_WIDTH=${SCREEN_WIDTH:-480}
SCREEN_HEIGHT=${SCREEN_HEIGHT:-800}
CONF=${CONF:-0.25}
MAX_FRAMES=${MAX_FRAMES:-0}
# 当前是明确标记的示例三区；正式机位改为自己的标定 JSON，并设 DEBUG_ZONES=0。
ZONES_PROFILE=${ZONES_PROFILE:-}
DEBUG_ZONES=${DEBUG_ZONES:-1}
