# media_engine configuration (default path: /oem/usr/share/media_engine.yaml)
# YAML subset: flat "key: value" scalar map; '#' comments; strings may be
# quoted with ' or ". All values can be overridden on the command line.

cam_id: 0
iq_dir: /oem/usr/share/iqfiles

device: /dev/video24
format: NV12
width: 3840
height: 2160
fps: 30

connector_id: 97
plane_id: 75
preview: on
# Board screen preview rotation via RGA: 0/90/180/270 (clockwise).
# Only affects the local preview branch.
preview_rotation: 0
# KMS preview output size: RGA scales+rotates to the screen resolution so
# the VOP plane stays within its input limits (RV1126B caps at 1920x1920).
preview_width: 480
preview_height: 800
# Pushed stream rotation via RGA: 0/90/180/270 (clockwise).
# Only affects the GB28181 live branch; image handling stays in C,
# the daemon protocol does not carry rotation.
stream_rotation: 0
af_mode: off

socket: /var/run/gb28181_media.sock
snapshot_dir: /data/media_engine/snapshots

# Analytics is intentionally disabled at factory default.  Once T1 has
# measured a board-supported model/input, set enabled and fill width/height/
# fps/model.  Dimensions and model are not guessed here.
analytics_enabled: off
analytics_backend: rockiva
# analytics_model: <board-validated-model>
# analytics_width: <board-validated-even-width>
# analytics_height: <board-validated-even-height>
# analytics_fps: <board-validated-fps>
analytics_score_threshold_q: 0       # confidence in [0,10000]
analytics_confirm_frames: 3
analytics_confirm_ms: 300
analytics_debounce_ms: 300
analytics_disappear_grace_ms: 1000
analytics_cooldown_ms: 5000
analytics_update_interval_ms: 5000
analytics_send_updates: off
analytics_send_end: off
analytics_roi_enabled: off
# ROI coordinates use [0,10000] normalized units when enabled.
# analytics_roi_left: 0
# analytics_roi_top: 0
# analytics_roi_right: 10000
# analytics_roi_bottom: 10000
analytics_line_enabled: off
# Line endpoints use [0,10000] normalized units when enabled.
# analytics_line_x1: 0
# analytics_line_y1: 0
# analytics_line_x2: 10000
# analytics_line_y2: 10000
analytics_rule_id: people-flow
analytics_rule_type: occupancy
analytics_evidence_mode: stock_wvp_pull
analytics_evidence_max_bytes: 536870912
analytics_evidence_retention_s: 259200
analytics_evidence_jpeg_quality: 85
analytics_event_log_max_records: 4096
analytics_event_log_max_bytes: 67108864
